# The fallback of KTD8: the Debian icecast2 2.4.4 package with the same entrypoint
# and template. Use it only when the 2.5.0 image fails. BUTT must use SOURCE here,
# because 2.4.4 accepts no chunked PUT.
FROM debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends icecast2 media-types \
  && rm -rf /var/lib/apt/lists/* \
  && install -d -o icecast2 -g icecast -m 0700 /var/lib/icecast

COPY icecast.xml.template /etc/icecast/icecast.xml.template
COPY entrypoint.sh /usr/local/bin/icecast-entrypoint

USER icecast2
EXPOSE 8000
ENTRYPOINT ["/bin/sh", "/usr/local/bin/icecast-entrypoint"]
