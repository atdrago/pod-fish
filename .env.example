# Copy this file to .env and fill every value. .env is gitignored. Never commit it.

# The folder of the show, inside the content repo. Never the root of the content repo.
CONTENT_FOLDER=placeholder-content-folder

# The public URL of the feed. Its path must start with OBJECT_KEY_PREFIX.
FEED_URL=https://placeholder-host.example.com/placeholder-show/feed.xml
# The prefix of every object key of this show in the bucket.
OBJECT_KEY_PREFIX=placeholder-show
# The public base URL of the bucket. A media URL is this value plus the object key.
MEDIA_BASE_URL=https://placeholder-host.example.com
# The public page of the show. A live item links to it.
SHOW_PAGE_URL=https://placeholder-host.example.com/placeholder-show

# The Cloudflare account that holds the R2 bucket.
R2_ACCOUNT_ID=placeholder-account-id
# The R2 bucket name.
R2_BUCKET=placeholder-bucket
# The access key ID of the R2 token. Scope the token to the one bucket, with object read and write.
R2_ACCESS_KEY_ID=placeholder-access-key-id
# The secret access key of the R2 token.
R2_SECRET_ACCESS_KEY=placeholder-secret-access-key

# The public URL of the stream mount.
STREAM_MOUNT_URL=https://placeholder-stream.example.com/placeholder-show/live.mp3
# The public status page of the stream server.
STREAM_STATUS_URL=https://placeholder-stream.example.com/status-json.xsl

# The podping.cloud token. Leave this empty until the token arrives.
PODPING_CLOUD_TOKEN=

# The URL of this app on the Mac. Keep it equal to ORIGIN in the start script of package.json.
APP_ORIGIN=http://placeholder-loopback:5174
# The User-Agent of every request from this app. Name the app and its repo.
APP_USER_AGENT=placeholder-user-agent
